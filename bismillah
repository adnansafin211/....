<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Welcome - I'm ADS | College Homework Project</title>

<!-- Importing Google Fonts for precise typography matching -->
<link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

<style>
/* CSS Reset & Global Settings */
* {
box-sizing: border-box;
margin: 0;
padding: 0;
}

body {
/* Exact deep purple/indigo radial background matching your image */
background: radial-gradient(circle at center, #1b0a3f 0%, #0d0221 60%, #05010a 100%);
height: 100vh;
overflow: hidden;
font-family: 'Poppins', sans-serif;
display: flex;
justify-content: center;
align-items: center;
color: #ffffff;
position: relative;
}

/* --- NEON RING BACKGROUND EFFECT --- */
.neon-ring-container {
position: absolute;
width: 100%;
height: 100%;
display: flex;
justify-content: center;
align-items: center;
pointer-events: none;
overflow: hidden;
z-index: 1;
}

.glowing-neon-ring {
width: 85vmax;
height: 85vmax;
border-radius: 50%;
border: 4px solid #ff0088;
/* Multi-layered glow shadow to replicate the intense neon lighting in the image */
box-shadow:
0 0 60px rgba(255, 0, 136, 0.8),
inset 0 0 60px rgba(255, 0, 136, 0.8),
0 0 120px rgba(255, 0, 136, 0.4),
inset 0 0 120px rgba(255, 0, 136, 0.4);
opacity: 0.85;
}

/* --- MAIN CONTENT CONTAINER --- */
.content-container {
position: relative;
z-index: 2;
text-align: center;
display: flex;
flex-direction: column;
align-items: center;
gap: 15px;
padding: 20px;
}

/* Welcome text styling with side decorative lines */
.welcome-wrapper {
display: flex;
align-items: center;
justify-content: center;
gap: 20px;
width: 100%;
}

.line {
height: 2px;
width: 70px;
background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.9));
}

.line.right {
background: linear-gradient(90deg, rgba(255, 255, 255, 0.9), transparent);
}

.welcome-text {
font-family: 'Great Vibes', cursive;
font-size: 3.2rem;
color: #ffffff;
font-weight: 400;
letter-spacing: 2px;
}

/* Name text styling */
.name-text {
font-size: 4.2rem;
font-weight: 700;
letter-spacing: 1.5px;
color: #ffffff;
margin-top: -5px;
text-shadow: 0 0 25px rgba(255, 255, 255, 0.35);
}

/* --- ELUSIVE CORNER-JUMPING BUTTON --- */
.dodge-button {
margin-top: 15px;
display: inline-block;
padding: 12px 28px;
border: 2px solid rgba(255, 255, 255, 0.9);
border-radius: 35px;
background: rgba(30, 10, 60, 0.5);
color: #ffffff;
font-family: 'Poppins', sans-serif;
font-size: 0.95rem;
font-weight: 400;
text-align: center;
cursor: pointer;
user-select: none;
box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
z-index: 10;
transition: background 0.2s ease, transform 0.1s ease;
}

.dodge-button:hover {
background: rgba(255, 0, 136, 0.25);
}

/* --- POPUP MODAL STYLING (EASTER EGG) --- */
.popup-overlay {
position: fixed;
top: 0;
left: 0;
width: 100%;
height: 100%;
background: rgba(5, 1, 12, 0.85);
display: flex;
justify-content: center;
align-items: center;
z-index: 100;
opacity: 0;
pointer-events: none;
transition: opacity 0.35s ease;
}

.popup-overlay.active {
opacity: 1;
pointer-events: auto;
}

.popup-box {
background: #180736;
border: 2.5px solid #ff0088;
padding: 35px 45px;
border-radius: 20px;
text-align: center;
box-shadow: 0 0 45px rgba(255, 0, 136, 0.65);
max-width: 440px;
animation: popIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes popIn {
0% { transform: scale(0.8); opacity: 0; }
100% { transform: scale(1); opacity: 1; }
}

.popup-box h2 {
font-size: 1.35rem;
margin-bottom: 25px;
color: #fff;
line-height: 1.5;
font-weight: 600;
}

.popup-box button {
padding: 10px 26px;
background: #ff0088;
border: none;
border-radius: 25px;
color: white;
font-weight: 600;
cursor: pointer;
font-size: 1rem;
transition: background 0.2s ease, transform 0.1s ease;
box-shadow: 0 4px 15px rgba(255, 0, 136, 0.4);
}

.popup-box button:hover {
background: #e00077;
transform: scale(1.05);
}
</style>
</head>
<body>

<!-- Glowing Neon Ring Background Element -->
<div class="neon-ring-container">
<div class="glowing-neon-ring"></div>
</div>

<!-- Main Landing View -->
<div class="content-container">
<div class="welcome-wrapper">
<div class="line"></div>
<div class="welcome-text">Welcome</div>
<div class="line right"></div>
</div>
<div class="name-text">I’m ADS</div>
<div id="dodge-btn" class="dodge-button">
wanna cut my 2 marks<br><span style="font-size: 0.8rem; opacity: 0.8;">(catch me if you can)</span>
</div>
</div>

<!-- Secret Popup Modal -->
<div class="popup-overlay" id="popup">
<div class="popup-box">
<h2>You finally caught me🎉,but I did my homework🤫</h2>
<button onclick="resetGame()">Awesome 😎</button>
</div>
</div>

<!-- Interactive JavaScript Engine -->
<script>
const btn = document.getElementById('dodge-btn');
const popup = document.getElementById('popup');
let lastClickTime = 0;
let clickCount = 0;

function handleButtonInteraction(e) {
const currentTime = Date.now();

// Check if clicks happen within less than 0.5 seconds (500 ms)
if (currentTime - lastClickTime < 500) {
clickCount++;
} else {
clickCount = 1;
}
lastClickTime = currentTime;

// If clicked twice rapidly (< 0.5s), trigger the hidden Easter egg message
if (clickCount >= 2) {
popup.classList.add('active');
clickCount = 0;
return;
}

// Switch to fixed layout to allow free coordinate movement across the window
btn.style.position = 'fixed';

const padding = 50; // Safety boundary padding from screen edges
const maxX = window.innerWidth - btn.offsetWidth - padding;
const maxY = window.innerHeight - btn.offsetHeight - padding;

// Define the 4 distant corner zones of the screen so it jumps far away
const corners = [
{ x: padding, y: padding }, // Top-Left Corner
{ x: maxX, y: padding }, // Top-Right Corner
{ x: padding, y: maxY }, // Bottom-Left Corner
{ x: maxX, y: maxY } // Bottom-Right Corner
];

// Pick a random corner destination far away
const randomCorner = corners[Math.floor(Math.random() * corners.length)];

// Add a small randomized offset within that corner zone so it doesn't land on the exact same pixel every time
const jitterX = randomCorner.x + (Math.random() * 80 - 40);
const jitterY = randomCorner.y + (Math.random() * 80 - 40);

// Ensure coordinates stay inside window boundaries safely
const finalX = Math.max(padding, Math.min(maxX, jitterX));
const finalY = Math.max(padding, Math.min(maxY, jitterY));

// Apply new distant coordinates
btn.style.left = finalX + 'px';
btn.style.top = finalY + 'px';
}

// Trigger strictly on click now as requested
btn.addEventListener('click', handleButtonInteraction);

function resetGame() {
popup.classList.remove('active');
btn.style.position = 'static'; // Reset position back to center flow
}
</script>
</body>
</html>

